# MOMENTUM — Environment Configuration Example

# Server Port & Public Origin (used across Mac, iPhone, and PWA installs)
PORT="3000"
APP_URL="https://your-momentum-domain.example.com"

# Persistent SQLite Directory (mount a persistent disk volume here in production)
# Defaults to ./data when omitted. Stored database file: <MOMENTUM_DATA_DIR>/momentum.db
MOMENTUM_DATA_DIR="./data"

# Cryptographic Session Signing Secret (REQUIRED in production; never commit real secrets)
SESSION_SECRET="replace-with-at-least-32-random-hex-bytes"

# Optional Notion Life OS Integration
NOTION_API_KEY="secret_your_notion_integration_token"
NOTION_DATABASE_ID="your_notion_database_id"

