# MOMENTUM — Environment Configuration Example

# Optional Supabase Integration (PostgreSQL Database & Auth)
# When provided, MOMENTUM syncs with your managed Supabase project.
# When omitted, MOMENTUM operates with full local offline persistence.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional Notion Life OS Integration
NOTION_API_KEY="secret_your_notion_integration_token"
NOTION_DATABASE_ID="your_notion_database_id"

# Base Application Host URL
APP_URL="http://localhost:3000"
